// Writes the scenes in examples/. Run from the repository root: ./build/aztek --script examples/tools/make_examples.mel --screenshot /tmp/x.png
// Names stay relative, so the scenes find each other wherever they are put.
chdir "examples";

// ---------------------------------------------------------------------------------------------------- Modelling history
file -f -new;
polyCube -n "box" -w 4 -h 4 -d 4 -sx 2 -sy 2 -sz 2;
polyExtrudeFacet -ltz 2 -ls 0.6 0.6 1 "box.f[8:11]";
polyBevel3 -o 0.2 -sg 2 "box.e[0:3]";
polySmooth -dv 1 "box";
polySphere -n "ball" -r 2 -sx 16 -sy 12;
move -r 7 2 0 "ball";
polyMirrorFace -axis 0 -cm 0 -mps 0 "ball";
polyCone -n "cone" -r 2 -h 4;
move -r -7 2 0 "cone";
polyPoke "cone.f[0]";
select -cl;
file -rename "modelling_history.ma";
file -f -s -type "mayaAscii";

// --------------------------------------------------------------------------------------------------------------- Lights
file -f -new;
polyPlane -n "floor" -w 24 -h 24 -sx 8 -sy 8;
polySphere -n "ballBlinn" -r 2;
move -a -4 2 0;
string $shiny = `shadingNode -asShader blinn -n "shinyBlinn"`;
setAttr ($shiny + ".color") -type "double3" 0.8 0.8 0.8;
hyperShade -assign $shiny "ballBlinn";
polySphere -n "ballPhong" -r 2;
move -a 4 2 0;
string $hard = `shadingNode -asShader phong -n "hardPhong"`;
setAttr ($hard + ".color") -type "double3" 0.8 0.8 0.8;
hyperShade -assign $hard "ballPhong";
string $key = `directionalLight -n "keyLight" -i 0.7 -rgb 1 0.95 0.85`;
rotate -a -50 -30 0 "keyLight";
string $spot = `spotLight -n "greenSpot" -i 2 -rgb 0.2 1 0.3 -ca 40`;
setAttr "greenSpotShape.penumbraAngle" 10;
move -a 0 10 8 "greenSpot";
rotate -a -50 0 0 "greenSpot";
string $point = `pointLight -n "redPoint" -i 40 -rgb 1 0.2 0.2 -d 2`;
move -a -8 4 4 "redPoint";
ambientLight -n "fill" -i 0.08;
modelEditor -e -displayLights "all" modelPanel4;
select -cl;
file -rename "lights.ma";
file -f -s -type "mayaAscii";

// ------------------------------------------------------------------------------------------------------------ Materials
file -f -new;
polySphere -n "plain" -r 2;
move -r -6 2 0;
polyCube -n "textured" -w 4 -h 4 -d 4;
move -r 0 2 0;
polyPlane -n "floor" -w 24 -h 12 -sx 8 -sy 4;
polyCylinder -n "faces" -r 2 -h 4;
move -r 6 2 0;
string $blinn = `shadingNode -asShader blinn -n "shiny"`;
setAttr ($blinn + ".color") -type "double3" 0.7 0.1 0.1;
hyperShade -assign $blinn "plain";
string $check = `shadingNode -asShader lambert -n "checked"`;
string $file = `shadingNode -asTexture file -n "checkerFile"`;
string $place = `shadingNode -asUtility place2dTexture -n "checkerPlace"`;
setAttr -type "string" ($file + ".fileTextureName") "textures/checker.png";
connectAttr ($place + ".outUV") ($file + ".uvCoord");
connectAttr ($file + ".outColor") ($check + ".color");
hyperShade -assign $check "textured";
hyperShade -assign $check "floor";
string $grad = `shadingNode -asShader lambert -n "fading"`;
string $file2 = `shadingNode -asTexture file -n "gradientFile"`;
setAttr -type "string" ($file2 + ".fileTextureName") "textures/gradient.png";
connectAttr ($file2 + ".outColor") ($grad + ".color");
hyperShade -assign $grad "faces.f[0:9]";
select -cl;
file -rename "materials.ma";
file -f -s -type "mayaAscii";

// ----------------------------------------------------------------------------------- A small character arm, coloured and keyed
file -f -new;
polyCylinder -n "arm" -r 1 -h 12 -sx 12 -sy 12;
rotate -a 0 0 90 "arm";
move -a 6 0 0 "arm";
makeIdentity -a true -t 1 -r 1 -s 1 "arm";
select -cl;
joint -n "shoulder" -p 0 0 0;
joint -n "elbow" -p 6 0 -0.5;
joint -n "wrist" -p 12 0 0;
skinCluster -n "armSkin" -mi 2 "shoulder" "arm";
ikHandle -n "armIk" -sj "shoulder" -ee "wrist" -sol "ikRPsolver";
circle -n "handCtrl" -nr 1 0 0 -r 2;
move -a 12 0 0 "handCtrl";
makeIdentity -a true -t 1 "handCtrl";
parent "armIk" "handCtrl";
setAttr "handCtrlShape.overrideEnabled" 1;
setAttr "handCtrlShape.overrideColor" 13;
circle -n "poleCtrl" -nr 0 0 1 -r 1;
move -a 6 0 -6 "poleCtrl";
makeIdentity -a true -t 1 "poleCtrl";
poleVectorConstraint "poleCtrl" "armIk";
setAttr "poleCtrlShape.overrideEnabled" 1;
setAttr "poleCtrlShape.overrideColor" 6;
circle -n "rootCtrl" -nr 0 1 0 -r 16;
setAttr "rootCtrlShape.overrideEnabled" 1;
setAttr "rootCtrlShape.overrideColor" 17;
parent "handCtrl" "poleCtrl" "rootCtrl";
polyCube -n "guide" -w 30 -h 0.2 -d 30;
move -a 6 -5 0 "guide";
setAttr "guide.overrideEnabled" 1;
setAttr "guide.overrideDisplayType" 1;
setKeyframe -t 1 -v 0 "handCtrl.translateX";
setKeyframe -t 1 -v 0 "handCtrl.translateY";
setKeyframe -t 30 -v -4 "handCtrl.translateX";
setKeyframe -t 30 -v 5 "handCtrl.translateY";
setKeyframe -t 60 -v 0 "handCtrl.translateX";
setKeyframe -t 60 -v 0 "handCtrl.translateY";
playbackOptions -min 1 -max 60;
currentTime 1;
select -cl;
file -rename "rig_arm.ma";
file -f -s -type "mayaAscii";

// ----------------------------------------------------------------------------------------- References: nested, with edits
file -f -new;
polyCylinder -n "post" -r 0.5 -h 6;
move -a 0 3 0 "post";
polySphere -n "lamp" -r 1;
move -a 0 7 0 "lamp";
group -n "lampPost" "post" "lamp";
select -cl;
file -rename "ref_prop.ma";
file -f -s -type "mayaAscii";

file -f -new;
polyPlane -n "ground" -w 20 -h 20;
file -r -ns "near" "ref_prop.ma";
file -r -ns "far" "ref_prop.ma";
setAttr "near:lampPost.translateX" -6;
setAttr "far:lampPost.translateX" 6;
setAttr "far:lamp.scaleX" 2;
setAttr "far:lamp.scaleY" 2;
setAttr "far:lamp.scaleZ" 2;
select -cl;
file -rename "ref_street.ma";
file -f -s -type "mayaAscii";

file -f -new;
file -r -ns "street" "ref_street.ma";
polySphere -n "ball" -r 1.5;
setKeyframe -t 1 -v -8 "ball.translateX";
setKeyframe -t 60 -v 8 "ball.translateX";
setKeyframe -t 1 -v 1.5 "ball.translateY";
setKeyframe -t 30 -v 6 "ball.translateY";
setKeyframe -t 60 -v 1.5 "ball.translateY";
setKeyframe -t 1 -v 0 "street:far:lampPost.rotateZ";
setKeyframe -t 60 -v -20 "street:far:lampPost.rotateZ";
playbackOptions -min 1 -max 60;
currentTime 1;
select -cl;
file -rename "references.ma";
file -f -s -type "mayaAscii";
file -f -new;
