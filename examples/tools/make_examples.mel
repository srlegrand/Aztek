// Writes the scenes in examples/. Run from the repository root: ./build/aztek --script examples/tools/make_examples.mel --screenshot /tmp/x.png
// Names stay relative, so the scenes find each other wherever they are put.
chdir "examples";

// ---------------------------------------------------------------------------------------------------- Modelling history
file -f -new;
polyCube -n "box" -w 4 -h 4 -d 4 -sx 2 -sy 2 -sz 2;
polyExtrudeFacet -ltz 2 -ls 0.6 0.6 1 "box.f[8:11]";
polyBevel3 -o 0.2 -sg 2 "box.e[0:3]";
polySmooth -dv 1 "box";
polySphere -n "ball" -r 2 -sx 16 -sy 12;
move -r 7 2 0 "ball";
polyMirrorFace -axis 0 -cm 0 -mps 0 "ball";
polyCone -n "cone" -r 2 -h 4;
move -r -7 2 0 "cone";
polyPoke "cone.f[0]";
select -cl;
file -rename "modelling_history.ma";
file -f -s -type "mayaAscii";

// --------------------------------------------------------------------------------------------------------------- Lights
file -f -new;
polyPlane -n "floor" -w 24 -h 24 -sx 8 -sy 8;
polySphere -n "ballBlinn" -r 2;
move -a -4 2 0;
string $shiny = `shadingNode -asShader blinn -n "shinyBlinn"`;
setAttr ($shiny + ".color") -type "double3" 0.8 0.8 0.8;
hyperShade -assign $shiny "ballBlinn";
polySphere -n "ballPhong" -r 2;
move -a 4 2 0;
string $hard = `shadingNode -asShader phong -n "hardPhong"`;
setAttr ($hard + ".color") -type "double3" 0.8 0.8 0.8;
hyperShade -assign $hard "ballPhong";
string $key = `directionalLight -n "keyLight" -i 0.7 -rgb 1 0.95 0.85`;
rotate -a -50 -30 0 "keyLight";
string $spot = `spotLight -n "greenSpot" -i 2 -rgb 0.2 1 0.3 -ca 40`;
setAttr "greenSpotShape.penumbraAngle" 10;
move -a 0 10 8 "greenSpot";
rotate -a -50 0 0 "greenSpot";
string $point = `pointLight -n "redPoint" -i 40 -rgb 1 0.2 0.2 -d 2`;
move -a -8 4 4 "redPoint";
ambientLight -n "fill" -i 0.08;
modelEditor -e -displayLights "all" modelPanel4;
select -cl;
file -rename "lights.ma";
file -f -s -type "mayaAscii";

// ------------------------------------------------------------------------------------------------------------ Materials
file -f -new;
polySphere -n "plain" -r 2;
move -r -6 2 0;
polyCube -n "textured" -w 4 -h 4 -d 4;
move -r 0 2 0;
polyPlane -n "floor" -w 24 -h 12 -sx 8 -sy 4;
polyCylinder -n "faces" -r 2 -h 4;
move -r 6 2 0;
string $blinn = `shadingNode -asShader blinn -n "shiny"`;
setAttr ($blinn + ".color") -type "double3" 0.7 0.1 0.1;
hyperShade -assign $blinn "plain";
string $check = `shadingNode -asShader lambert -n "checked"`;
string $file = `shadingNode -asTexture file -n "checkerFile"`;
string $place = `shadingNode -asUtility place2dTexture -n "checkerPlace"`;
setAttr -type "string" ($file + ".fileTextureName") "textures/checker.png";
connectAttr ($place + ".outUV") ($file + ".uvCoord");
connectAttr ($file + ".outColor") ($check + ".color");
hyperShade -assign $check "textured";
hyperShade -assign $check "floor";
string $grad = `shadingNode -asShader lambert -n "fading"`;
string $file2 = `shadingNode -asTexture file -n "gradientFile"`;
setAttr -type "string" ($file2 + ".fileTextureName") "textures/gradient.png";
connectAttr ($file2 + ".outColor") ($grad + ".color");
hyperShade -assign $grad "faces.f[0:9]";
select -cl;
file -rename "materials.ma";
file -f -s -type "mayaAscii";

// ----------------------------------------------------------------------------------- A small character arm, coloured and keyed
file -f -new;
polyCylinder -n "arm" -r 1 -h 12 -sx 12 -sy 12;
rotate -a 0 0 90 "arm";
move -a 6 0 0 "arm";
makeIdentity -a true -t 1 -r 1 -s 1 "arm";
select -cl;
joint -n "shoulder" -p 0 0 0;
joint -n "elbow" -p 6 0 -0.5;
joint -n "wrist" -p 12 0 0;
skinCluster -n "armSkin" -mi 2 "shoulder" "arm";
ikHandle -n "armIk" -sj "shoulder" -ee "wrist" -sol "ikRPsolver";
circle -n "handCtrl" -nr 1 0 0 -r 2;
move -a 12 0 0 "handCtrl";
makeIdentity -a true -t 1 "handCtrl";
parent "armIk" "handCtrl";
setAttr "handCtrlShape.overrideEnabled" 1;
setAttr "handCtrlShape.overrideColor" 13;
circle -n "poleCtrl" -nr 0 0 1 -r 1;
move -a 6 0 -6 "poleCtrl";
makeIdentity -a true -t 1 "poleCtrl";
poleVectorConstraint "poleCtrl" "armIk";
setAttr "poleCtrlShape.overrideEnabled" 1;
setAttr "poleCtrlShape.overrideColor" 6;
circle -n "rootCtrl" -nr 0 1 0 -r 16;
setAttr "rootCtrlShape.overrideEnabled" 1;
setAttr "rootCtrlShape.overrideColor" 17;
parent "handCtrl" "poleCtrl" "rootCtrl";
polyCube -n "guide" -w 30 -h 0.2 -d 30;
move -a 6 -5 0 "guide";
setAttr "guide.overrideEnabled" 1;
setAttr "guide.overrideDisplayType" 1;
setKeyframe -t 1 -v 0 "handCtrl.translateX";
setKeyframe -t 1 -v 0 "handCtrl.translateY";
setKeyframe -t 30 -v -4 "handCtrl.translateX";
setKeyframe -t 30 -v 5 "handCtrl.translateY";
setKeyframe -t 60 -v 0 "handCtrl.translateX";
setKeyframe -t 60 -v 0 "handCtrl.translateY";
playbackOptions -min 1 -max 60;
currentTime 1;
select -cl;
file -rename "rig_arm.ma";
file -f -s -type "mayaAscii";

// ----------------------------------------------------------------------------------------- References: nested, with edits
file -f -new;
polyCylinder -n "post" -r 0.5 -h 6;
move -a 0 3 0 "post";
polySphere -n "lamp" -r 1;
move -a 0 7 0 "lamp";
group -n "lampPost" "post" "lamp";
select -cl;
file -rename "ref_prop.ma";
file -f -s -type "mayaAscii";

file -f -new;
polyPlane -n "ground" -w 20 -h 20;
file -r -ns "near" "ref_prop.ma";
file -r -ns "far" "ref_prop.ma";
setAttr "near:lampPost.translateX" -6;
setAttr "far:lampPost.translateX" 6;
setAttr "far:lamp.scaleX" 2;
setAttr "far:lamp.scaleY" 2;
setAttr "far:lamp.scaleZ" 2;
select -cl;
file -rename "ref_street.ma";
file -f -s -type "mayaAscii";

file -f -new;
file -r -ns "street" "ref_street.ma";
polySphere -n "ball" -r 1.5;
setKeyframe -t 1 -v -8 "ball.translateX";
setKeyframe -t 60 -v 8 "ball.translateX";
setKeyframe -t 1 -v 1.5 "ball.translateY";
setKeyframe -t 30 -v 6 "ball.translateY";
setKeyframe -t 60 -v 1.5 "ball.translateY";
setKeyframe -t 1 -v 0 "street:far:lampPost.rotateZ";
setKeyframe -t 60 -v -20 "street:far:lampPost.rotateZ";
playbackOptions -min 1 -max 60;
currentTime 1;
select -cl;
file -rename "references.ma";
file -f -s -type "mayaAscii";
// -------------------------------------------------------------------------------------------------------------- Dynamics
// Cloth falling onto a ball: play from frame 1.
file -f -new;
playbackOptions -min 1 -max 120;
polySphere -n "ball" -r 1 -sx 32 -sy 16;
polyPlane -n "sheet" -w 4 -h 4 -sx 40 -sy 40;
move 0 2 0 sheet;
currentTime 1;
createCloth -n "sheetCloth" sheet;
collider -n "ballCollider" ball;
clothPreset -preset "cotton" sheet;
select -cl;
file -rename "cloth_drape.ma";
file -f -s -type "mayaAscii";

// Particles from an emitter, pulled down, blown about, and bouncing on a floor.
file -f -new;
playbackOptions -min 1 -max 120;
polyPlane -n "floor" -w 12 -h 12;
collider floor;
string $spout[] = `emitter -type "omni" -r 150 -spd 3 -n "spout"`;
move 0 3 0 $spout[0];
setAttr ($spout[1] + ".particleRenderType") 4;
setAttr ($spout[1] + ".radius") 0.05;
setAttr ($spout[1] + ".bounce") 0.4;
setAttr ($spout[1] + ".lifespanMode") 1;
setAttr ($spout[1] + ".lifespan") 3;
gravity $spout[1];
turbulence -m 4 $spout[1];
currentTime 1;
select -cl;
file -rename "particles_fields.ma";
file -f -s -type "mayaAscii";

// Boxes dropped on a sheet held at its corners: rigid bodies and cloth in one solve.
file -f -new;
playbackOptions -min 1 -max 120;
polyPlane -n "hammock" -w 4 -h 4 -sx 30 -sy 30;
currentTime 1;
createCloth -n "hammockCloth" hammock;
setAttr hammockCloth.damp 0.5;
dynamicConstraint -type "nail" "hammock.vtx[0]" "hammock.vtx[30]" "hammock.vtx[930]" "hammock.vtx[960]";
for ($k = 0; $k < 3; $k++) {
    string $box[] = `polyCube -n ("box" + ($k + 1)) -w 0.6 -h 0.6 -d 0.6`;
    move (($k - 1) * 1.0) (1.5 + $k * 0.8) 0 $box[0];
    rotate 0 ($k * 25) 0 $box[0];
    rigidBody -active -si 1 -m 2 -b 0.1 $box[0];
}
select -cl;
file -rename "rigid_on_cloth.ma";
file -f -s -type "mayaAscii";
file -f -new;

// ------------------------------------------------------------------------------------------------------ Render spheres
// Glass, metals, plastic and car paint under a sky image, for the renderer.
file -f -new;
polyPlane -n "floor" -w 60 -h 60 -sx 1 -sy 1;
string $floorMat = `shadingNode -asShader standardSurface -n "floorMat"`;
setAttr ($floorMat + ".baseColor") -type "double3" 0.42 0.42 0.4;
setAttr ($floorMat + ".specularRoughness") 0.45;
hyperShade -assign $floorMat "floor";
string $names[] = {"glass", "gold", "chrome", "plastic", "paint"};
for ($i = 0; $i < 5; $i++) {
    polySphere -n ($names[$i] + "Ball") -r 1 -sx 48 -sy 32;
    move -a (($i - 2) * 2.4) 1 0;
    setAttr ($names[$i] + "BallShape.aiSubdivType") 1;
    setAttr ($names[$i] + "BallShape.aiSubdivIterations") 1;
    string $m = `shadingNode -asShader standardSurface -n ($names[$i] + "Mat")`;
    hyperShade -assign $m ($names[$i] + "Ball");
}
setAttr "glassMat.base" 0;
setAttr "glassMat.transmission" 1;
setAttr "glassMat.specularRoughness" 0;
setAttr "glassMat.transmissionColor" -type "double3" 0.85 0.95 0.92;
setAttr "goldMat.metalness" 1;
setAttr "goldMat.base" 1;
setAttr "goldMat.baseColor" -type "double3" 1 0.77 0.34;
setAttr "goldMat.specularRoughness" 0.25;
setAttr "chromeMat.metalness" 1;
setAttr "chromeMat.base" 1;
setAttr "chromeMat.baseColor" -type "double3" 0.95 0.95 0.95;
setAttr "chromeMat.specularRoughness" 0.05;
setAttr "plasticMat.baseColor" -type "double3" 0.8 0.08 0.06;
setAttr "plasticMat.specularRoughness" 0.3;
setAttr "paintMat.baseColor" -type "double3" 0.03 0.08 0.45;
setAttr "paintMat.metalness" 0.5;
setAttr "paintMat.specularRoughness" 0.4;
setAttr "paintMat.coat" 1;
setAttr "paintMat.coatRoughness" 0.02;
createNode transform -n "sky";
createNode aiSkyDomeLight -n "skyShape" -p "sky";
string $skyFile = `shadingNode -asTexture file -n "skyImage"`;
setAttr ($skyFile + ".fileTextureName") -type "string" "textures/sky.hdr";
setAttr ($skyFile + ".colorSpace") -type "string" "scene-linear Rec.709-sRGB";
connectAttr ($skyFile + ".outColor") "skyShape.color";
setAttr "skyShape.aiSamples" 2;
camera -n "shotCam" -focalLength 35;
move -a 0 3.2 13.5;
rotate -a -10 0 0;
setAttr "shotCamShape.renderable" 1;
setAttr "defaultResolution.width" 960;
setAttr "defaultResolution.height" 540;
setAttr "defaultArnoldRenderOptions.AASamples" 4;
setAttr "defaultArnoldRenderOptions.GISpecularDepth" 4;
setAttr "defaultRenderGlobals.imageFilePrefix" -type "string" "<Scene>";
select -cl;
file -rename "render_spheres.ma";
file -f -s -type "mayaAscii";

// ---------------------------------------------------------------------------------------------------------- Cornell box
// The classic box: white, red and green walls, a warm light in the ceiling, two blocks.
file -f -new;
string $wallMat[] = {"whiteWall", "redWall", "greenWall"};
float $wallColor[] = {0.73, 0.73, 0.73, 0.63, 0.065, 0.05, 0.14, 0.45, 0.091};
for ($i = 0; $i < 3; $i++) {
    shadingNode -asShader standardSurface -n $wallMat[$i];
    setAttr ($wallMat[$i] + ".baseColor") -type "double3" $wallColor[$i * 3] $wallColor[$i * 3 + 1] $wallColor[$i * 3 + 2];
    setAttr ($wallMat[$i] + ".specular") 0;
}
polyPlane -n "floorWall" -w 5.5 -h 5.5 -sx 1 -sy 1;
hyperShade -assign "whiteWall" "floorWall";
polyPlane -n "ceilingWall" -w 5.5 -h 5.5 -sx 1 -sy 1;
rotate -a 180 0 0;
move -a 0 5.5 0;
hyperShade -assign "whiteWall" "ceilingWall";
polyPlane -n "backWall" -w 5.5 -h 5.5 -sx 1 -sy 1;
rotate -a 90 0 0;
move -a 0 2.75 -2.75;
hyperShade -assign "whiteWall" "backWall";
polyPlane -n "leftWall" -w 5.5 -h 5.5 -sx 1 -sy 1;
rotate -a 0 0 -90;
move -a -2.75 2.75 0;
hyperShade -assign "redWall" "leftWall";
polyPlane -n "rightWall" -w 5.5 -h 5.5 -sx 1 -sy 1;
rotate -a 0 0 90;
move -a 2.75 2.75 0;
hyperShade -assign "greenWall" "rightWall";
polyCube -n "tallBlock" -w 1.6 -h 3.3 -d 1.6;
move -a -0.9 1.65 -0.8;
rotate -a 0 18 0;
hyperShade -assign "whiteWall" "tallBlock";
polyCube -n "shortBlock" -w 1.6 -h 1.6 -d 1.6;
move -a 0.9 0.8 0.7;
rotate -a 0 -17 0;
hyperShade -assign "whiteWall" "shortBlock";
createNode transform -n "lamp";
createNode aiAreaLight -n "lampShape" -p "lamp";
move -a 0 5.49 0 "lamp";
rotate -a -90 0 0 "lamp";
scale -a 0.6 0.5 1 "lamp";
setAttr "lampShape.color" -type "double3" 1 0.85 0.6;
setAttr "lampShape.intensity" 8;
setAttr "lampShape.aiExposure" 2;
setAttr "lampShape.aiSamples" 2;
camera -n "boxCam" -focalLength 35;
move -a 0 2.75 10.6;
setAttr "boxCamShape.renderable" 1;
setAttr "defaultResolution.width" 640;
setAttr "defaultResolution.height" 640;
setAttr "defaultArnoldRenderOptions.AASamples" 5;
setAttr "defaultArnoldRenderOptions.GIDiffuseDepth" 4;
select -cl;
file -rename "cornell_box.ma";
file -f -s -type "mayaAscii";
file -f -new;
