createNode transform -n "sky";
createNode aiSkyDomeLight -n "skyShape" -p "sky";
	setAttr -k off ".v";
	setAttr ".ai_samples" 2;
createNode transform -n "shotCam";
	setAttr ".t" -type "double3" 0 3.2 13.5 ;
	setAttr ".r" -type "double3" -10 0 0 ;
createNode camera -n "shotCamShape" -p "shotCam";
	setAttr -k off ".v";
select -ne :defaultRenderGlobals;
	setAttr ".imageFilePrefix" -type "string" "<Scene>";
createNode standardSurface -n "floorMat";
	setAttr ".bc" -type "float3" 0.42 0.42 0.4 ;
	setAttr ".sr2" 0.45;
createNode shadingEngine -n "floorMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo1";
createNode standardSurface -n "glassMat";
	setAttr ".b" 0;
	setAttr ".sr2" 0;
	setAttr ".t" 1;
	setAttr ".tc" -type "float3" 0.85 0.95 0.92 ;
createNode shadingEngine -n "glassMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo2";
createNode standardSurface -n "goldMat";
	setAttr ".bc" -type "float3" 1 0.77 0.34 ;
	setAttr ".m" 1;
	setAttr ".sr2" 0.25;
createNode shadingEngine -n "goldMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo3";
createNode standardSurface -n "chromeMat";
	setAttr ".bc" -type "float3" 0.95 0.95 0.95 ;
	setAttr ".m" 1;
	setAttr ".sr2" 0.05;
createNode shadingEngine -n "chromeMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo4";
createNode standardSurface -n "plasticMat";
	setAttr ".bc" -type "float3" 0.8 0.08 0.06 ;
	setAttr ".sr2" 0.3;
createNode shadingEngine -n "plasticMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo5";
createNode standardSurface -n "paintMat";
	setAttr ".bc" -type "float3" 0.03 0.08 0.45 ;
	setAttr ".m" 0.5;
	setAttr ".sr2" 0.4;
	setAttr ".c" 1;
	setAttr ".cr" 0.02;
createNode shadingEngine -n "paintMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo6";
createNode file -n "skyImage";
	setAttr ".ftn" -type "string" "textures/sky.hdr";
	setAttr ".cs" -type "string" "scene-linear Rec.709-sRGB";
createNode lightLinker -s -n "lightLinker1";
createNode aiOptions -s -n "defaultArnoldRenderOptions";
	setAttr ".AASamples" 4;
	setAttr ".GISpecularDepth" 4;
createNode aiAOVFilter -s -n "defaultArnoldFilter";
createNode aiAOVDriver -s -n "defaultArnoldDriver";
createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 1 ".l";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 60 -ast 1 -aet 200 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
