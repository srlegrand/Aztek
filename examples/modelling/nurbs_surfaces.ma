createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 2 ".l";
select -ne :defaultLightSet;
	setAttr -s 2 ".dsm";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 120 -ast 1 -aet 200 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
select -ne :initialShadingGroup;
	setAttr -s 4 ".dsm";
	setAttr ".ro" yes;
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "vaseMatSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "vaseMatSG.message" ":defaultLightSet.message";
connectAttr "extrude1.outputSurface" "tubeShape.create";
connectAttr "makeNurbCircle1.outputCurve" "ribbonShape0.create";
connectAttr "makeNurbCircle2.outputCurve" "ribbonShape1.create";
connectAttr "makeNurbCircle3.outputCurve" "ribbonShape2.create";
connectAttr "makeNurbCircle4.outputCurve" "ribbonShape3.create";
connectAttr "makeNurbCircle5.outputCurve" "tubeProfileShape.create";
connectAttr "makeNurbsSquare1.outputCurve" "trimOutlineShape.create";
connectAttr "tubePathShape.worldSpace" "extrude1.inputCurve[1]";
connectAttr "tubeProfileShape.worldSpace" "extrude1.inputCurve[0]";
connectAttr "vaseMat.oc" "vaseMatSG.ss";
connectAttr "fillLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "fillLightShape.ltd" ":lightList1.l" -na;
connectAttr "keyLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "keyLightShape.ltd" ":lightList1.l" -na;
connectAttr "loftAsPolygonsShape.iog" ":initialShadingGroup.dsm" -na;
connectAttr "loftedShape.iog" ":initialShadingGroup.dsm" -na;
connectAttr "trimmedPlaneShape.iog" ":initialShadingGroup.dsm" -na;
connectAttr "tubeShape.iog" ":initialShadingGroup.dsm" -na;
connectAttr "vaseMat.msg" ":defaultShaderList1.s" -na;
connectAttr "vaseMatSG.pa" ":renderPartition.st" -na;
connectAttr "vaseShape.iog" "vaseMatSG.dsm" -na;
// End of nurbs_surfaces.ma
