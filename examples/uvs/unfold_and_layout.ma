	setAttr -k off ".v";
	setAttr ".in" 0.25;
createNode lambert -n "checkerMat";
createNode file -n "checkerMatFile";
	setAttr ".ftn" -type "string" "../textures/checker.png";
createNode place2dTexture -n "checkerMatPlace";
	setAttr ".re" -type "float2" 6 6 ;
createNode shadingEngine -n "checkerMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lambert -n "floorMat";
	setAttr ".c" -type "float3" 0.45 0.45 0.45 ;
createNode shadingEngine -n "floorMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
