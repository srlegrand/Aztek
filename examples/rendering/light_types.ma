createNode transform -n "spot";
	setAttr ".t" -type "double3" -8 6 3 ;
	setAttr ".r" -type "double3" -45 -45 0 ;
createNode spotLight -n "spotShape" -p "spot";
	setAttr -k off ".v";
	setAttr ".cl" -type "float3" 1 0.8 0.5 ;
	setAttr ".in" 1.2;
	setAttr ".ca" 35;
	setAttr ".pa" 8;
createNode transform -n "bulb";
	setAttr ".t" -type "double3" 4 1.8 2 ;
createNode pointLight -n "bulbShape" -p "bulb";
	setAttr -k off ".v";
	setAttr ".cl" -type "float3" 0.4 0.6 1 ;
	setAttr ".in" 0.8;
createNode transform -n "softbox";
	setAttr ".t" -type "double3" 0 4 3 ;
	setAttr ".r" -type "double3" -60 0 0 ;
createNode areaLight -n "softboxShape" -p "softbox";
	setAttr -k off ".v";
	setAttr ".in" 0.8;
createNode transform -n "sun";
	setAttr ".r" -type "double3" -40 50 0 ;
createNode directionalLight -n "sunShape" -p "sun";
	setAttr -k off ".v";
	setAttr ".cl" -type "float3" 1 0.95 0.85 ;
	setAttr ".in" 0.25;
createNode transform -n "ambient";
createNode ambientLight -n "ambientShape" -p "ambient";
	setAttr -k off ".v";
	setAttr ".in" 0.04;
createNode transform -n "shotCam";
	setAttr ".t" -type "double3" 0 6 16 ;
	setAttr ".r" -type "double3" -15.708637829015748 0 0 ;
createNode camera -n "shotCamShape" -p "shotCam";
	setAttr -k off ".v";
	setAttr ".coi" 16.62077013859466;
select -ne :defaultRenderGlobals;
	setAttr ".imageFilePrefix" -type "string" "<Scene>";
createNode lambert -n "floorMat";
	setAttr ".c" -type "float3" 0.6 0.6 0.6 ;
createNode shadingEngine -n "floorMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lambert -n "wallMat";
	setAttr ".c" -type "float3" 0.6 0.6 0.6 ;
createNode shadingEngine -n "wallMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode standardSurface -n "targetMat";
	setAttr ".bc" -type "float3" 0.85 0.85 0.85 ;
	setAttr ".sr2" 0.3;
createNode shadingEngine -n "targetMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lightLinker -s -n "lightLinker1";
createNode aiOptions -s -n "defaultArnoldRenderOptions";
	setAttr ".AASamples" 4;
createNode aiAOVFilter -s -n "defaultArnoldFilter";
createNode aiAOVDriver -s -n "defaultArnoldDriver";
createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 5 ".l";
select -ne :defaultLightSet;
	setAttr -s 5 ".dsm";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 240 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "floorMatSG.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "wallMatSG.message" ":defaultLightSet.message";
