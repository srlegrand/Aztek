createNode transform -n "floor";
createNode mesh -n "floorShape" -p "floor";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -20 0 20 20 0 20 -20 0 -20 20 0 -20;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "keyLight";
	setAttr ".r" -type "double3" -45 35 0 ;
createNode directionalLight -n "keyLightShape" -p "keyLight";
	setAttr -k off ".v";
createNode transform -n "fillLight";
createNode ambientLight -n "fillLightShape" -p "fillLight";
	setAttr -k off ".v";
	setAttr ".in" 0.25;
createNode animCurveTL -n "ball_translateY";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 15 ".ktv[0:14]"  1 1 10 9 19 1 25 5.8 32 1 37 3.88 42 1 46 2.7279999999999998 50 1 53 2.0368 57 1 60 1.62208 63 1 66 1.373248 69 1;
	setAttr -s 15 ".kit[0:14]"  9 9 9 9 9 9 9 9 9 9 9 9 9 9 9;
	setAttr -s 15 ".kot[0:14]"  9 9 9 9 9 9 9 9 9 9 9 9 9 9 9;
createNode animCurveTU -n "ball_scaleY";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 21 ".ktv[0:20]"  1 0.75 3 1.1 10 1 19 0.75 21 1.1 25 1 32 0.75 34 1.1 37 1 42 0.75 44 1.1 46 1 50 0.75 52 1.1 53 1 57 0.75 59 1.1 60 1 63 0.75 65 1.1 66 1;
createNode animCurveTU -n "ball_scaleX";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 21 ".ktv[0:20]"  1 1.2 3 0.92 10 1 19 1.2 21 0.92 25 1 32 1.2 34 0.92 37 1 42 1.2 44 0.92 46 1 50 1.2 52 0.92 53 1 57 1.2 59 0.92 60 1 63 1.2 65 0.92 66 1;
createNode animCurveTL -n "ball_translateX";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 -10 69 3.608089599999999;
	setAttr -s 2 ".kit[0:1]"  2 2;
	setAttr -s 2 ".kot[0:1]"  2 2;
createNode blinn -n "ballMat";
	setAttr ".c" -type "float3" 0.9 0.2 0.15 ;
createNode shadingEngine -n "ballMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lambert -n "floorMat";
	setAttr ".c" -type "float3" 0.45 0.45 0.45 ;
createNode shadingEngine -n "floorMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lightLinker -s -n "lightLinker1";
createNode aiOptions -s -n "defaultArnoldRenderOptions";
createNode aiAOVFilter -s -n "defaultArnoldFilter";
createNode aiAOVDriver -s -n "defaultArnoldDriver";
createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 2 ".l";
select -ne :defaultLightSet;
	setAttr -s 2 ".dsm";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 79 -ast 1 -aet 200 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "ballMatSG.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "floorMatSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "ballMatSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "floorMatSG.message" ":defaultLightSet.message";
connectAttr "ballMat.oc" "ballMatSG.ss";
connectAttr "ball_scaleX.o" "ball.sx";
connectAttr "ball_scaleY.o" "ball.sy";
connectAttr "ball_translateX.o" "ball.tx";
connectAttr "ball_translateY.o" "ball.ty";
connectAttr "floorMat.oc" "floorMatSG.ss";
connectAttr "ballMat.msg" ":defaultShaderList1.s" -na;
connectAttr "ballMatSG.pa" ":renderPartition.st" -na;
connectAttr "ballShape.iog" "ballMatSG.dsm" -na;
connectAttr "fillLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "fillLightShape.ltd" ":lightList1.l" -na;
connectAttr "floorMat.msg" ":defaultShaderList1.s" -na;
connectAttr "floorMatSG.pa" ":renderPartition.st" -na;
connectAttr "floorShape.iog" "floorMatSG.dsm" -na;
connectAttr "keyLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "keyLightShape.ltd" ":lightList1.l" -na;
