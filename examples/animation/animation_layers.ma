//Maya ASCII 2024 scene
//Name: animation_layers.ma
//Codeset: UTF-8
requires maya "2024";
currentUnit -l centimeter -a degree -t film;
fileInfo "application" "aztek";
fileInfo "version" "1.0.0";
createNode transform -s -n "persp";
	setAttr ".v" no;
	setAttr ".t" -type "double3" 0 6 16 ;
	setAttr ".r" -type "double3" -15.708637829015748 0 0 ;
createNode camera -s -n "perspShape" -p "persp";
	setAttr ".coi" 16.62077013859466;
	setAttr ".imn" -type "string" "persp";
	setAttr ".den" -type "string" "persp_depth";
	setAttr ".man" -type "string" "persp_mask";
	setAttr ".hc" -type "string" "viewSet -p %camera";
createNode transform -s -n "top";
	setAttr ".v" no;
	setAttr ".t" -type "double3" 0 1000.1 0 ;
	setAttr ".r" -type "double3" -90 0 0 ;
createNode camera -s -n "topShape" -p "top";
	setAttr ".coi" 1000.1;
	setAttr ".o" yes;
	setAttr ".rnd" no;
	setAttr ".imn" -type "string" "top";
	setAttr ".den" -type "string" "top_depth";
	setAttr ".man" -type "string" "top_mask";
	setAttr ".hc" -type "string" "viewSet -t %camera";
createNode transform -s -n "front";
	setAttr ".v" no;
	setAttr ".t" -type "double3" 0 0 1000.1 ;
createNode camera -s -n "frontShape" -p "front";
	setAttr ".coi" 1000.1;
	setAttr ".o" yes;
	setAttr ".rnd" no;
	setAttr ".imn" -type "string" "front";
	setAttr ".den" -type "string" "front_depth";
	setAttr ".man" -type "string" "front_mask";
	setAttr ".hc" -type "string" "viewSet -f %camera";
createNode transform -s -n "side";
	setAttr ".v" no;
	setAttr ".t" -type "double3" 1000.1 0 0 ;
	setAttr ".r" -type "double3" 0 90 0 ;
createNode camera -s -n "sideShape" -p "side";
	setAttr ".coi" 1000.1;
	setAttr ".o" yes;
	setAttr ".rnd" no;
	setAttr ".imn" -type "string" "side";
	setAttr ".den" -type "string" "side_depth";
	setAttr ".man" -type "string" "side_mask";
	setAttr ".hc" -type "string" "viewSet -s %camera";
createNode transform -n "hopper";
	setAttr ".t" -type "double3" -6 0 0 ;
createNode mesh -n "hopperShape" -p "hopper";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 14 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:13]" -type "float2" 0.375 0 0.625 0 0.625 0.25 0.375 0.25 0.625 0.5 0.375 0.5 0.625 0.75 0.375 0.75 0.625 1 0.375 1 0.875 0 0.875 0.25 0.125 0 0.125 0.25 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 8 ".vt";
	setAttr ".vt[0:7]"  -0.75 -0.75 0.75 0.75 -0.75 0.75 0.75 0.75 0.75 -0.75 0.75 0.75 0.75 0.75 -0.75 -0.75 0.75 -0.75 0.75 -0.75 -0.75 -0.75 -0.75 -0.75;
	setAttr -s 12 ".ed";
	setAttr ".ed[0:11]"  0 1 0 1 2 0 2 3 0 3 0 0 2 4 0 4 5 0 5 3 0 4 6 0 6 7 0 7 5 0 6 1 0 0 7 0;
	setAttr -s 6 -ch 24 ".fc[0:5]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 
		f 4 -3 4 5 6 mu 0 4 3 2 4 5 
		f 4 -6 7 8 9 mu 0 4 5 4 6 7 
		f 4 -9 10 -1 11 mu 0 4 7 6 8 9 
		f 4 -11 -8 -5 -2 mu 0 4 1 10 11 2 
		f 4 -12 -4 -7 -10 mu 0 4 12 0 3 13 ;
createNode transform -n "floor";
createNode mesh -n "floorShape" -p "floor";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -10 0 10 10 0 10 -10 0 -10 10 0 -10;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "keyLight";
	setAttr ".r" -type "double3" -45 35 0 ;
createNode directionalLight -n "keyLightShape" -p "keyLight";
	setAttr -k off ".v";
createNode transform -n "fillLight";
createNode ambientLight -n "fillLightShape" -p "fillLight";
	setAttr -k off ".v";
	setAttr ".in" 0.25;
createNode animCurveTL -n "hopper_translateX";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 -6 100 6;
	setAttr -s 2 ".kit[0:1]"  2 2;
	setAttr -s 2 ".kot[0:1]"  2 2;
createNode animCurveTL -n "hopper_translateY";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 1 ".ktv[0]"  1 0.75;
createNode animLayer -n "BaseAnimation";
	setAttr ".ovrd" yes;
createNode animLayer -n "hops";
	setAttr -s 10 ".dsm";
	setAttr -s 8 ".bnds";
createNode animBlendNodeBoolean -n "hopper_visibility_hops";
	setAttr ".ia" yes;
	setAttr ".ib" yes;
createNode animBlendNodeAdditiveDL -n "hopper_translateX_hops";
createNode animBlendNodeAdditiveDL -n "hopper_translateY_hops";
createNode animBlendNodeAdditiveDL -n "hopper_translateZ_hops";
createNode animBlendNodeAdditiveRotation -n "hopper_rotate_hops";
createNode animBlendNodeAdditiveScale -n "hopper_scaleX_hops";
	setAttr ".ia" 1;
createNode animBlendNodeAdditiveScale -n "hopper_scaleY_hops";
	setAttr ".ia" 1;
createNode animBlendNodeAdditiveScale -n "hopper_scaleZ_hops";
	setAttr ".ia" 1;
createNode animCurveTL -n "hopper_translateY_hops_inputB";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 18 ".ktv[0:17]"  1 -0.75 7 1.25 13 -0.75 19 1.25 25 -0.75 31 1.25 37 -0.75 43 1.25 49 -0.75 55 1.25 61 -0.75 67 1.25 73 -0.75 79 1.25 85 -0.75 91 1.25 97 -0.75 103 1.25;
createNode animLayer -n "spin";
	setAttr ".wgth" 0.5;
	setAttr -s 10 ".dsm";
	setAttr -s 8 ".bnds";
createNode animBlendNodeBoolean -n "hopper_visibility_spin";
	setAttr ".ib" yes;
createNode animBlendNodeAdditiveDL -n "hopper_translateX_spin";
createNode animBlendNodeAdditiveDL -n "hopper_translateY_spin";
createNode animBlendNodeAdditiveDL -n "hopper_translateZ_spin";
createNode animBlendNodeAdditiveRotation -n "hopper_rotate_spin";
createNode animBlendNodeAdditiveScale -n "hopper_scaleX_spin";
createNode animBlendNodeAdditiveScale -n "hopper_scaleY_spin";
createNode animBlendNodeAdditiveScale -n "hopper_scaleZ_spin";
createNode animCurveTA -n "hopper_rotate_spin_inputBY";
	setAttr ".tan" 18;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 0 100 720;
createNode blinn -n "hopperMat";
	setAttr ".c" -type "float3" 0.3 0.6 0.9 ;
createNode shadingEngine -n "hopperMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lambert -n "floorMat";
	setAttr ".c" -type "float3" 0.45 0.45 0.45 ;
createNode shadingEngine -n "floorMatSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode lightLinker -s -n "lightLinker1";
createNode aiOptions -s -n "defaultArnoldRenderOptions";
createNode aiAOVFilter -s -n "defaultArnoldFilter";
createNode aiAOVDriver -s -n "defaultArnoldDriver";
createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 2 ".l";
select -ne :defaultLightSet;
	setAttr -s 2 ".dsm";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 100 -ast 1 -aet 200 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "hopperMatSG.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "floorMatSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "hopperMatSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "floorMatSG.message" ":defaultLightSet.message";
connectAttr "BaseAnimation.csol" "hops.sslo";
connectAttr "BaseAnimation.csol" "spin.sslo";
connectAttr "BaseAnimation.fgwt" "hops.pwth";
connectAttr "BaseAnimation.fgwt" "spin.pwth";
connectAttr "BaseAnimation.omte" "hops.pmte";
connectAttr "BaseAnimation.omte" "spin.pmte";
connectAttr "floorMat.oc" "floorMatSG.ss";
connectAttr "hopper.ro" "hopper_rotate_hops.ro";
connectAttr "hopper.ro" "hopper_rotate_spin.ro";
connectAttr "hopper.rx" "hops.dsm" -na;
connectAttr "hopper.rx" "spin.dsm" -na;
connectAttr "hopper.ry" "hops.dsm" -na;
connectAttr "hopper.ry" "spin.dsm" -na;
connectAttr "hopper.rz" "hops.dsm" -na;
connectAttr "hopper.rz" "spin.dsm" -na;
connectAttr "hopper.sx" "hops.dsm" -na;
connectAttr "hopper.sx" "spin.dsm" -na;
connectAttr "hopper.sy" "hops.dsm" -na;
connectAttr "hopper.sy" "spin.dsm" -na;
connectAttr "hopper.sz" "hops.dsm" -na;
connectAttr "hopper.sz" "spin.dsm" -na;
connectAttr "hopper.tx" "hops.dsm" -na;
connectAttr "hopper.tx" "spin.dsm" -na;
connectAttr "hopper.ty" "hops.dsm" -na;
connectAttr "hopper.ty" "spin.dsm" -na;
connectAttr "hopper.tz" "hops.dsm" -na;
connectAttr "hopper.tz" "spin.dsm" -na;
connectAttr "hopper.v" "hops.dsm" -na;
connectAttr "hopper.v" "spin.dsm" -na;
connectAttr "hopperMat.oc" "hopperMatSG.ss";
connectAttr "hopper_rotate_hops.msg" "hops.bnds[4]";
connectAttr "hopper_rotate_hops.ox" "hopper_rotate_spin.iax";
connectAttr "hopper_rotate_hops.oy" "hopper_rotate_spin.iay";
connectAttr "hopper_rotate_hops.oz" "hopper_rotate_spin.iaz";
connectAttr "hopper_rotate_spin.msg" "spin.bnds[4]";
connectAttr "hopper_rotate_spin.ox" "hopper.rx";
connectAttr "hopper_rotate_spin.oy" "hopper.ry";
connectAttr "hopper_rotate_spin.oz" "hopper.rz";
connectAttr "hopper_rotate_spin_inputBY.o" "hopper_rotate_spin.iby";
connectAttr "hopper_scaleX_hops.msg" "hops.bnds[5]";
connectAttr "hopper_scaleX_hops.o" "hopper_scaleX_spin.ia";
connectAttr "hopper_scaleX_spin.msg" "spin.bnds[5]";
connectAttr "hopper_scaleX_spin.o" "hopper.sx";
connectAttr "hopper_scaleY_hops.msg" "hops.bnds[6]";
connectAttr "hopper_scaleY_hops.o" "hopper_scaleY_spin.ia";
connectAttr "hopper_scaleY_spin.msg" "spin.bnds[6]";
connectAttr "hopper_scaleY_spin.o" "hopper.sy";
connectAttr "hopper_scaleZ_hops.msg" "hops.bnds[7]";
connectAttr "hopper_scaleZ_hops.o" "hopper_scaleZ_spin.ia";
connectAttr "hopper_scaleZ_spin.msg" "spin.bnds[7]";
connectAttr "hopper_scaleZ_spin.o" "hopper.sz";
connectAttr "hopper_translateX.o" "hopper_translateX_hops.ia";
connectAttr "hopper_translateX_hops.msg" "hops.bnds[1]";
connectAttr "hopper_translateX_hops.o" "hopper_translateX_spin.ia";
connectAttr "hopper_translateX_spin.msg" "spin.bnds[1]";
connectAttr "hopper_translateX_spin.o" "hopper.tx";
connectAttr "hopper_translateY.o" "hopper_translateY_hops.ia";
connectAttr "hopper_translateY_hops.msg" "hops.bnds[2]";
connectAttr "hopper_translateY_hops.o" "hopper_translateY_spin.ia";
connectAttr "hopper_translateY_hops_inputB.o" "hopper_translateY_hops.ib";
connectAttr "hopper_translateY_spin.msg" "spin.bnds[2]";
connectAttr "hopper_translateY_spin.o" "hopper.ty";
connectAttr "hopper_translateZ_hops.msg" "hops.bnds[3]";
connectAttr "hopper_translateZ_hops.o" "hopper_translateZ_spin.ia";
connectAttr "hopper_translateZ_spin.msg" "spin.bnds[3]";
connectAttr "hopper_translateZ_spin.o" "hopper.tz";
connectAttr "hopper_visibility_hops.msg" "hops.bnds[0]";
connectAttr "hopper_visibility_hops.o" "hopper_visibility_spin.ia";
connectAttr "hopper_visibility_spin.msg" "spin.bnds[0]";
connectAttr "hopper_visibility_spin.o" "hopper.v";
connectAttr "hops.bgwt" "hopper_rotate_hops.wa";
connectAttr "hops.bgwt" "hopper_scaleX_hops.wa";
connectAttr "hops.bgwt" "hopper_scaleY_hops.wa";
connectAttr "hops.bgwt" "hopper_scaleZ_hops.wa";
connectAttr "hops.bgwt" "hopper_translateX_hops.wa";
connectAttr "hops.bgwt" "hopper_translateY_hops.wa";
connectAttr "hops.bgwt" "hopper_translateZ_hops.wa";
connectAttr "hops.bgwt" "hopper_visibility_hops.wa";
connectAttr "hops.fgwt" "hopper_rotate_hops.wb";
connectAttr "hops.fgwt" "hopper_scaleX_hops.wb";
connectAttr "hops.fgwt" "hopper_scaleY_hops.wb";
connectAttr "hops.fgwt" "hopper_scaleZ_hops.wb";
connectAttr "hops.fgwt" "hopper_translateX_hops.wb";
connectAttr "hops.fgwt" "hopper_translateY_hops.wb";
connectAttr "hops.fgwt" "hopper_translateZ_hops.wb";
connectAttr "hops.fgwt" "hopper_visibility_hops.wb";
connectAttr "hops.oram" "hopper_rotate_hops.acm";
connectAttr "hops.play" "BaseAnimation.cdly[0]";
connectAttr "hops.sam" "hopper_scaleX_hops.acm";
connectAttr "hops.sam" "hopper_scaleY_hops.acm";
connectAttr "hops.sam" "hopper_scaleZ_hops.acm";
connectAttr "hops.sl" "BaseAnimation.chsl[0]";
connectAttr "spin.bgwt" "hopper_rotate_spin.wa";
connectAttr "spin.bgwt" "hopper_scaleX_spin.wa";
connectAttr "spin.bgwt" "hopper_scaleY_spin.wa";
connectAttr "spin.bgwt" "hopper_scaleZ_spin.wa";
connectAttr "spin.bgwt" "hopper_translateX_spin.wa";
connectAttr "spin.bgwt" "hopper_translateY_spin.wa";
connectAttr "spin.bgwt" "hopper_translateZ_spin.wa";
connectAttr "spin.bgwt" "hopper_visibility_spin.wa";
connectAttr "spin.fgwt" "hopper_rotate_spin.wb";
connectAttr "spin.fgwt" "hopper_scaleX_spin.wb";
connectAttr "spin.fgwt" "hopper_scaleY_spin.wb";
connectAttr "spin.fgwt" "hopper_scaleZ_spin.wb";
connectAttr "spin.fgwt" "hopper_translateX_spin.wb";
connectAttr "spin.fgwt" "hopper_translateY_spin.wb";
connectAttr "spin.fgwt" "hopper_translateZ_spin.wb";
connectAttr "spin.fgwt" "hopper_visibility_spin.wb";
connectAttr "spin.oram" "hopper_rotate_spin.acm";
connectAttr "spin.play" "BaseAnimation.cdly[1]";
connectAttr "spin.sam" "hopper_scaleX_spin.acm";
connectAttr "spin.sam" "hopper_scaleY_spin.acm";
connectAttr "spin.sam" "hopper_scaleZ_spin.acm";
connectAttr "spin.sl" "BaseAnimation.chsl[1]";
connectAttr "fillLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "fillLightShape.ltd" ":lightList1.l" -na;
connectAttr "floorMat.msg" ":defaultShaderList1.s" -na;
connectAttr "floorMatSG.pa" ":renderPartition.st" -na;
connectAttr "floorShape.iog" "floorMatSG.dsm" -na;
connectAttr "hopperMat.msg" ":defaultShaderList1.s" -na;
connectAttr "hopperMatSG.pa" ":renderPartition.st" -na;
connectAttr "hopperShape.iog" "hopperMatSG.dsm" -na;
connectAttr "keyLight.iog" ":defaultLightSet.dsm" -na;
connectAttr "keyLightShape.ltd" ":lightList1.l" -na;
// End of animation_layers.ma
