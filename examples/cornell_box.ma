//Maya ASCII 2024 scene
//Name: cornell_box.ma
//Codeset: UTF-8
requires maya "2024";
currentUnit -l centimeter -a degree -t film;
fileInfo "application" "aztek";
fileInfo "version" "0.1.0";
createNode transform -n "floorWall";
createNode mesh -n "floorWallShape" -p "floorWall";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -2.75 0 2.75 2.75 0 2.75 -2.75 0 -2.75 2.75 0 -2.75;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "ceilingWall";
	setAttr ".t" -type "double3" 0 5.5 0 ;
	setAttr ".r" -type "double3" 180 0 0 ;
createNode mesh -n "ceilingWallShape" -p "ceilingWall";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -2.75 0 2.75 2.75 0 2.75 -2.75 0 -2.75 2.75 0 -2.75;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "backWall";
	setAttr ".t" -type "double3" 0 2.75 -2.75 ;
	setAttr ".r" -type "double3" 90 0 0 ;
createNode mesh -n "backWallShape" -p "backWall";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -2.75 0 2.75 2.75 0 2.75 -2.75 0 -2.75 2.75 0 -2.75;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "leftWall";
	setAttr ".t" -type "double3" -2.75 2.75 0 ;
	setAttr ".r" -type "double3" 0 0 -90 ;
createNode mesh -n "leftWallShape" -p "leftWall";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -2.75 0 2.75 2.75 0 2.75 -2.75 0 -2.75 2.75 0 -2.75;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "rightWall";
	setAttr ".t" -type "double3" 2.75 2.75 0 ;
	setAttr ".r" -type "double3" 0 0 90 ;
createNode mesh -n "rightWallShape" -p "rightWall";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 4 ".vt";
	setAttr ".vt[0:3]"  -2.75 0 2.75 2.75 0 2.75 -2.75 0 -2.75 2.75 0 -2.75;
	setAttr -s 4 ".ed";
	setAttr ".ed[0:3]"  0 1 1 1 3 1 3 2 1 2 0 1;
	setAttr -s 1 -ch 4 ".fc[0]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 ;
createNode transform -n "tallBlock";
	setAttr ".t" -type "double3" -0.9 1.65 -0.8 ;
	setAttr ".r" -type "double3" 0 18 0 ;
createNode mesh -n "tallBlockShape" -p "tallBlock";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 14 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:13]" -type "float2" 0.375 0 0.625 0 0.625 0.25 0.375 0.25 0.625 0.5 0.375 0.5 0.625 0.75 0.375 0.75 0.625 1 0.375 1 0.875 0 0.875 0.25 0.125 0 0.125 0.25 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 8 ".vt";
	setAttr ".vt[0:7]"  -0.8 -1.65 0.8 0.8 -1.65 0.8 0.8 1.65 0.8 -0.8 1.65 0.8 0.8 1.65 -0.8 -0.8 1.65 -0.8 0.8 -1.65 -0.8 -0.8 -1.65 -0.8;
	setAttr -s 12 ".ed";
	setAttr ".ed[0:11]"  0 1 0 1 2 0 2 3 0 3 0 0 2 4 0 4 5 0 5 3 0 4 6 0 6 7 0 7 5 0 6 1 0 0 7 0;
	setAttr -s 6 -ch 24 ".fc[0:5]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 
		f 4 -3 4 5 6 mu 0 4 3 2 4 5 
		f 4 -6 7 8 9 mu 0 4 5 4 6 7 
		f 4 -9 10 -1 11 mu 0 4 7 6 8 9 
		f 4 -11 -8 -5 -2 mu 0 4 1 10 11 2 
		f 4 -12 -4 -7 -10 mu 0 4 12 0 3 13 ;
createNode transform -n "shortBlock";
	setAttr ".t" -type "double3" 0.9 0.8 0.7 ;
	setAttr ".r" -type "double3" 0 -17 0 ;
createNode mesh -n "shortBlockShape" -p "shortBlock";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 14 ".uvst[0].uvsp";
	setAttr ".uvst[0].uvsp[0:13]" -type "float2" 0.375 0 0.625 0 0.625 0.25 0.375 0.25 0.625 0.5 0.375 0.5 0.625 0.75 0.375 0.75 0.625 1 0.375 1 0.875 0 0.875 0.25 0.125 0 0.125 0.25 ;
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Ambient+Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
	setAttr -s 8 ".vt";
	setAttr ".vt[0:7]"  -0.8 -0.8 0.8 0.8 -0.8 0.8 0.8 0.8 0.8 -0.8 0.8 0.8 0.8 0.8 -0.8 -0.8 0.8 -0.8 0.8 -0.8 -0.8 -0.8 -0.8 -0.8;
	setAttr -s 12 ".ed";
	setAttr ".ed[0:11]"  0 1 0 1 2 0 2 3 0 3 0 0 2 4 0 4 5 0 5 3 0 4 6 0 6 7 0 7 5 0 6 1 0 0 7 0;
	setAttr -s 6 -ch 24 ".fc[0:5]" -type "polyFaces" 
		f 4 0 1 2 3 mu 0 4 0 1 2 3 
		f 4 -3 4 5 6 mu 0 4 3 2 4 5 
		f 4 -6 7 8 9 mu 0 4 5 4 6 7 
		f 4 -9 10 -1 11 mu 0 4 7 6 8 9 
		f 4 -11 -8 -5 -2 mu 0 4 1 10 11 2 
		f 4 -12 -4 -7 -10 mu 0 4 12 0 3 13 ;
createNode transform -n "lamp";
	setAttr ".t" -type "double3" 0 5.49 0 ;
	setAttr ".r" -type "double3" -90 0 0 ;
	setAttr ".s" -type "double3" 0.6 0.5 1 ;
createNode aiAreaLight -n "lampShape" -p "lamp";
	setAttr -k off ".v";
	setAttr ".cl" -type "float3" 1 0.85 0.6 ;
	setAttr ".in" 8;
	setAttr ".ai_exposure" 2;
	setAttr ".ai_samples" 2;
createNode transform -n "boxCam";
	setAttr ".t" -type "double3" 0 2.75 10.6 ;
createNode camera -n "boxCamShape" -p "boxCam";
	setAttr -k off ".v";
select -ne :defaultResolution;
	setAttr ".width" 640;
	setAttr ".height" 640;
createNode standardSurface -n "whiteWall";
	setAttr ".bc" -type "float3" 0.73 0.73 0.73 ;
	setAttr ".s" 0;
createNode standardSurface -n "redWall";
	setAttr ".bc" -type "float3" 0.63 0.065 0.05 ;
	setAttr ".s" 0;
createNode standardSurface -n "greenWall";
	setAttr ".bc" -type "float3" 0.14 0.45 0.091 ;
	setAttr ".s" 0;
createNode shadingEngine -n "whiteWallSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo1";
createNode shadingEngine -n "redWallSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo2";
createNode shadingEngine -n "greenWallSG";
	setAttr ".ihi" 0;
	setAttr ".ro" yes;
createNode materialInfo -n "materialInfo3";
createNode lightLinker -s -n "lightLinker1";
createNode aiOptions -s -n "defaultArnoldRenderOptions";
	setAttr ".AASamples" 5;
	setAttr ".GIDiffuseDepth" 4;
createNode aiAOVFilter -s -n "defaultArnoldFilter";
createNode aiAOVDriver -s -n "defaultArnoldDriver";
createNode aiAOVDriver -s -n "defaultArnoldDisplayDriver";
select -ne :lightList1;
	setAttr -s 1 ".l";
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 60 -ast 1 -aet 200 ";
	setAttr ".st" 6;
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "whiteWallSG.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "redWallSG.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "greenWallSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "whiteWallSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "redWallSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "greenWallSG.message" ":defaultLightSet.message";
connectAttr "greenWall.msg" "materialInfo3.m";
connectAttr "greenWall.oc" "greenWallSG.ss";
connectAttr "greenWallSG.msg" "materialInfo3.sg";
connectAttr "redWall.msg" "materialInfo2.m";
connectAttr "redWall.oc" "redWallSG.ss";
connectAttr "redWallSG.msg" "materialInfo2.sg";
connectAttr "whiteWall.msg" "materialInfo1.m";
connectAttr "whiteWall.oc" "whiteWallSG.ss";
connectAttr "whiteWallSG.msg" "materialInfo1.sg";
connectAttr "backWallShape.iog" "whiteWallSG.dsm" -na;
connectAttr "ceilingWallShape.iog" "whiteWallSG.dsm" -na;
connectAttr "floorWallShape.iog" "whiteWallSG.dsm" -na;
connectAttr "greenWall.msg" ":defaultShaderList1.s" -na;
connectAttr "greenWallSG.pa" ":renderPartition.st" -na;
connectAttr "lampShape.ltd" ":lightList1.l" -na;
connectAttr "leftWallShape.iog" "redWallSG.dsm" -na;
connectAttr "redWall.msg" ":defaultShaderList1.s" -na;
connectAttr "redWallSG.pa" ":renderPartition.st" -na;
connectAttr "rightWallShape.iog" "greenWallSG.dsm" -na;
connectAttr "shortBlockShape.iog" "whiteWallSG.dsm" -na;
connectAttr "tallBlockShape.iog" "whiteWallSG.dsm" -na;
connectAttr "whiteWall.msg" ":defaultShaderList1.s" -na;
connectAttr "whiteWallSG.pa" ":renderPartition.st" -na;
// End of cornell_box.ma
