    {"id": "create.camera", "area": "create", "setup": "", "call": "camera;", "expect": ["camera1", "cameraShape1"]},
    {"id": "create.createNode.transform", "area": "create", "setup": "", "call": "createNode transform;", "expect": "transform1"},
    {"id": "create.createNode.mesh", "area": "create", "setup": "", "call": "createNode mesh;", "expect": "polySurfaceShape1"},
    {"id": "create.shadingNode", "area": "create", "setup": "", "call": "shadingNode -asShader lambert;", "expect": "lambert2"},
    {"id": "create.directionalLight", "area": "create", "setup": "", "call": "directionalLight;", "expect": "directionalLightShape1"},

