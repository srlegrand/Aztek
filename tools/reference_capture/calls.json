{
  "about": "Calls run in a new scene in both the reference (capture.py) and Aztek (crates/aztek_host/tests/reference_fixtures.rs). setup runs first and its result is not kept; call is the one whose result is compared. lang is mel unless it says python, where call is an expression on cmds. expect is Aztek's hand-written reading of the reference, used until a capture exists.",
  "calls": [
    {"id": "create.polyCube", "area": "create", "setup": "", "call": "polyCube;", "expect": ["pCube1", "polyCube1"]},
    {"id": "create.polyCube.second", "area": "create", "setup": "polyCube;", "call": "polyCube;", "expect": ["pCube2", "polyCube2"]},
    {"id": "create.polySphere", "area": "create", "setup": "", "call": "polySphere;", "expect": ["pSphere1", "polySphere1"]},
    {"id": "create.polyPlane", "area": "create", "setup": "", "call": "polyPlane;", "expect": ["pPlane1", "polyPlane1"]},
