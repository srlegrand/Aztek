#!/bin/sh
# Starts Aztek inside the snap with the libraries and Python that came in it, and the keyboard and font data the snap
# carries where the base has none.
export PYTHONHOME="$SNAP/usr"
export PYTHONNOUSERSITE=1
export LD_LIBRARY_PATH="$SNAP/usr/lib:$SNAP/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XKB_CONFIG_ROOT="$SNAP/usr/share/X11/xkb"
export FONTCONFIG_PATH="$SNAP/etc/fonts"
export FONTCONFIG_FILE="$SNAP/etc/fonts/fonts.conf"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
exec "$SNAP/usr/bin/aztek" "$@"
